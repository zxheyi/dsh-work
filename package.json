{
  "name": "dsh-work",
  "version": "0.0.1-alpha.1",
  "private": true,
  "type": "module",
  "description": "Electron desktop composition of the official DeepSeek Harness CLI",
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "build": "node scripts/build-product.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "pnpm build",
    "test": "node --test scripts/*.test.mjs tests/typescript-toolchain.test.ts tests/work-controller.test.ts tests/work-remote.test.ts tests/work-client.test.ts tests/work-client-bundle.test.ts tests/work-surface.test.ts tests/work-bundle.test.ts tests/lifecycle-activity.test.ts tests/runtime-upgrade.test.ts tests/runtime-contract.test.ts tests/runtime-host.test.ts tests/official-launcher.test.ts tests/local-profile-discovery.test.ts tests/shadow-profile.test.ts tests/startup-preferences.test.ts tests/startup-checkpoint.test.ts tests/startup-presentation.test.ts tests/desktop-runtime-paths.test.ts tests/desktop-security.test.ts tests/renderer.test.ts tests/close-policy.test.ts tests/tray.test.ts tests/owned-test-home.test.ts tests/generation-store.test.ts tests/runtime-guardian.test.ts tests/guardian-client.test.ts tests/unavailable-guardian-client.test.ts tests/live-release-evidence.test.ts",
    "check": "pnpm typecheck && node scripts/verify-contract.mjs",
    "verify:familiar-v5": "node scripts/verify-familiar-v5-acceptance.mjs",
    "runtime:prepare": "node scripts/prepare-product-runtime.mjs",
    "runtime:verify": "node scripts/verify-product-runtime.mjs artifacts/runtime/context.json",
    "runtime:stage": "node scripts/stage-product-runtime.mjs artifacts/runtime/context.json artifacts/product-resources",
    "pretest:runtime": "pnpm build",
    "test:runtime": "node --test tests/runtime-integration.test.ts tests/guardian-integration.test.ts tests/work-client-loader.integration.test.ts tests/session-migration.integration.test.ts",
    "pretest:desktop": "pnpm build",
    "test:desktop": "node scripts/run-desktop-test.mjs",
    "pretest:work-shell": "pnpm build",
    "test:work-shell": "node scripts/run-desktop-work-shell-test.mjs",
    "pretest:conversation": "pnpm build",
    "test:conversation": "node scripts/run-native-conversation-test.mjs",
    "pretest:workspace-sessions": "pnpm build",
    "test:workspace-sessions": "node scripts/run-workspace-sessions-test.mjs",
    "pretest:session-navigation": "pnpm build",
    "test:session-navigation": "node scripts/run-session-navigation-test.mjs",
    "pretest:session-resource": "pnpm build",
    "test:session-resource": "node scripts/run-session-resource-test.mjs",
    "pretest:session-permission": "pnpm build",
    "test:session-permission": "node scripts/run-session-permission-test.mjs",
    "pretest:session-output": "pnpm build",
    "test:session-output": "node scripts/run-session-output-test.mjs",
    "pretest:runtime-context": "pnpm build",
    "test:runtime-context": "node scripts/run-runtime-context-test.mjs",
    "predesktop": "pnpm build",
    "desktop": "electron dist/apps/desktop/main.js",
    "verify:local": "node scripts/verify-local.mjs artifacts/runtime/context.json --desktop",
    "prepackage:desktop": "pnpm build",
    "package:desktop": "node scripts/package-desktop.mjs",
    "test:package": "node scripts/run-packaged-smoke.mjs",
    "capture:familiar-v5": "node scripts/capture-familiar-v5.mjs",
    "notices:generate": "node scripts/distribution-notices.mjs",
    "notices:verify-release": "node scripts/distribution-notices.mjs --release",
    "pretest:release-live": "pnpm build",
    "test:release-live": "node scripts/run-live-release-test.mjs",
    "notices:prepare-native": "node scripts/native-distribution.mjs",
    "package:archive": "node scripts/archive-desktop.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh": "0.1.5-rc.1",
    "@deepseek-ai/dsh-api-gateway": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.5-rc.1",
    "@deepseek-ai/dsh-cmdline": "0.1.5-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.5-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.1",
    "react": "18.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "24.13.3",
    "@types/react": "18.3.28",
    "electron": "44.0.0",
    "tsdown": "0.22.2",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@deepseek-ai/dsh-subprocess-local",
      "electron"
    ]
  },
  "license": "MIT",
  "author": "DSH Work contributors"
}
