{
  "name": "@dsh-work/work-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./remote": "./remote.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "external": ["@deepseek-ai/dsh-api-gateway/client", "@deepseek-ai/dsh-client-ui-primitives", "react"],
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-gateway": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.2",
    "react": "18.3.1"
  }
}
