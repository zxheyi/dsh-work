{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Work Tauri Prototype",
  "version": "0.0.0",
  "identifier": "com.dshwork.prototype",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DSH Work Tauri Prototype",
        "visible": false,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "externalBin": [
      "binaries/node"
    ]
  }
}
